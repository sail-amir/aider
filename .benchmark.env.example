# Credentials for the refactor benchmark local/proxy endpoint.
# Sourced before running benchmark.py. NOT committed (gitignored).
export OPENAI_API_BASE="REPLACE_ME"
export OPENAI_API_KEY="REPLACE_ME"
# Bypass the harness's "run in docker" guard. SAFE here because the refactor
# _test.py only does ast.parse on the edited file and never executes model code.
export AIDER_DOCKER=1
# Available served models (use as openai/<name> with aider):
#   glm-5.1, gpt-5.5, deepseek-v3.2   (think via reasoning_effort)
#   claude-opus-4-6-thinking          (thinking enabled by the alias itself)
# Note: claude-opus-4-7 exists but has NO thinking variant on this gateway;
#       claude-opus-4-8-aws has no available channel.
