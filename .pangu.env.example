# Pangu inference endpoint for distill_pangu.py (sourced by run_pangu_distill.sh).
# Copy to .pangu.env (gitignored) and fill in PANGU_CSB_TOKEN. NOT committed.
#
# NOTE: PANGU_MODEL is the model name sent to the endpoint ("pangu_auto") and is
# separate from the benchmark's --model (e.g. anthropic/pangu_auto_aider, which
# only selects aider's edit-format prompt). The "pangu" substring in the
# benchmark --model is what triggers this path.

# ROMA / OpenAI-style chat-completions endpoint (space-separate multiple for load-balancing):
export PANGU_API_URLS="http://onlineservice.cn-southwest-2.roma.huawei.com:8087/csb-inner-service/rest/infers/9429767e-0414-4c42-b84e-270504a7ab61?path=/v1/chat/completions"
export PANGU_CSB_TOKEN="REPLACE_ME"        # csb-token header (secret)
export PANGU_AUTH_TOKEN="nokey"            # Authorization: Bearer <this>
export PANGU_MODEL="pangu_auto"            # model name in the request body

# Sampling / generation params (match the standalone CLI usage):
export PANGU_MAX_TOKENS=120000
export PANGU_TEMPERATURE=1.0
export PANGU_TOP_P=0.8
export PANGU_TOP_K=-1
export PANGU_TIMEOUT=3600
export PANGU_BATCH_SIZE=64
export PANGU_MAX_RETRIES=3
export PANGU_STREAM=1                       # streaming on (set empty/comment to disable)
